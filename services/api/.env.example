PORT=5000
NODE_ENV=development

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=basa-koi
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@basa-koi.iam.gserviceaccount.com
# For multiline private keys in .env, wrap in double quotes or provide base64
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://basa-koi.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

